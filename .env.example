# Copy to .env (local) and set the same names in Vercel → Project → Settings → Environment Variables.

# Pooled Postgres connection string used by the running app.
#  - Neon:     use the "pooled" string (host contains -pooler) and append &pgbouncer=true
#  - Supabase: use the transaction-pooler string (port 6543) and append &pgbouncer=true
# Without pgbouncer=true, Prisma can fail on a pooled connection with "prepared statement already exists".
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/clinic_booking?sslmode=require"

# Direct (non-pooled) connection string, used only by `prisma migrate`.
# Locally this can be identical to DATABASE_URL (without pgbouncer=true).
DIRECT_URL="postgresql://USER:PASSWORD@HOST:5432/clinic_booking?sslmode=require"

# The key every API request must send in the X-API-Key header. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
API_KEY="change-me-to-a-long-random-string"
