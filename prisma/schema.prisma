generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL") // pooled connection (use this on Vercel)
  directUrl = env("DIRECT_URL")   // direct connection, used by migrations
}

enum BookingStatus {
  confirmed
  cancelled
}

model Slot {
  id       String    @id // chosen by the client (e.g. "s1") via POST /reset
  provider String
  start    DateTime
  end      DateTime
  bookings Booking[]

  @@index([start])
  @@index([provider])
}

model Booking {
  id        String        @id // generated by us (UUID)
  slotId    String
  slot      Slot          @relation(fields: [slotId], references: [id])
  name      String
  email     String // always stored lower-case
  status    BookingStatus @default(confirmed)
  createdAt DateTime      @default(now())

  @@index([slotId])
  @@index([email, createdAt, id])

  // LEVEL 3 — two people must never hold the same slot, even at the same instant.
  // Prisma cannot express a partial unique index, so it lives in the migration SQL:
  //   CREATE UNIQUE INDEX "Booking_one_confirmed_per_slot"
  //     ON "Booking" ("slotId") WHERE "status" = 'confirmed';
}

// LEVEL 4 — the stored response for an Idempotency-Key, replayed on retries.
model IdempotencyRecord {
  key         String   @id
  requestHash String
  response    Json
  createdAt   DateTime @default(now())
}

// LEVEL 5 — one row per POST /bookings attempt, used for a sliding 60 s window per email.
model BookingAttempt {
  id    BigInt   @id @default(autoincrement())
  email String
  at    DateTime

  @@index([email, at])
}
